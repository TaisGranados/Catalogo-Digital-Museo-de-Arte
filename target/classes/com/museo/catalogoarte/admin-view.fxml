<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.museo.catalogoarte.controller.AdminController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Administración de Obras de Arte">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <TableView fx:id="obrasTableView" prefHeight="450.0" prefWidth="860.0">
         <columns>
           <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
           <TableColumn fx:id="tituloColumn" prefWidth="200.0" text="Título" />
           <TableColumn fx:id="artistaColumn" prefWidth="150.0" text="Artista" />
           <TableColumn fx:id="anioColumn" prefWidth="80.0" text="Año" />
           <TableColumn fx:id="descripcionColumn" prefWidth="300.0" text="Descripción" />
         </columns>
      </TableView>
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button fx:id="anadirButton" onAction="#handleAnadirObra" text="Añadir Obra Nueva" />
            <Button fx:id="editarButton" onAction="#handleEditarObra" text="Editar Obra Seleccionada" />
            <Button fx:id="eliminarButton" onAction="#handleEliminarObra" text="Eliminar Obra Seleccionada" />
         </children>
      </HBox>
   </children>
</VBox>