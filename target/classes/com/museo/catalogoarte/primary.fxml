<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.museo.catalogoarte.controller.PrimaryController"
      prefHeight="600" prefWidth="800">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Catálogo de Obras de Arte">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>
    
    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="busquedaField" promptText="Buscar por título o artista..." HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="salaFilterComboBox" promptText="Filtrar por sala" />
    </HBox>
    
    <ListView fx:id="obrasListView" VBox.vgrow="ALWAYS" />
    
</VBox>