<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.museo.catalogoarte.controller.RegisterController" prefHeight="450.0" prefWidth="400.0">
    <padding>
        <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
    </padding>
    <children>
        <Label text="Registro de Nuevo Usuario">
            <font><Font name="System Bold" size="24.0" /></font>
        </Label>
        <Label fx:id="mensajeLabel" textFill="RED" wrapText="true" />
        <TextField fx:id="nombreField" promptText="Nombre Completo" />
        <TextField fx:id="emailField" promptText="Correo Electrónico" />
        <PasswordField fx:id="passwordField" promptText="Contraseña" />
        <PasswordField fx:id="confirmPasswordField" promptText="Confirmar Contraseña" />
        <Button onAction="#handleRegisterButtonAction" text="Registrar" />
    </children>
</VBox>