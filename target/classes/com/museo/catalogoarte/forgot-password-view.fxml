<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.museo.catalogoarte.controller.ForgotPasswordController" prefHeight="350.0" prefWidth="450.0">
    <padding>
        <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
    </padding>
    <children>
        <Label text="Recuperar Contraseña">
            <font><Font name="System Bold" size="24.0" /></font>
        </Label>

        <VBox fx:id="step1Box" alignment="CENTER" spacing="10.0">
            <children>
                <Label fx:id="infoLabel" text="Introduce tu correo electrónico para continuar." textAlignment="CENTER" wrapText="true" />
                <TextField fx:id="emailField" promptText="Correo Electrónico" />
                <Button onAction="#handleVerificarEmail" text="Verificar Correo" />
            </children>
        </VBox>

        <VBox fx:id="step2Box" alignment="CENTER" managed="false" spacing="10.0" visible="false">
            <children>
                <Label text="Introduce tu nueva contraseña." />
                <PasswordField fx:id="newPasswordField" promptText="Nueva Contraseña" />
                <PasswordField fx:id="confirmPasswordField" promptText="Confirmar Nueva Contraseña" />
                <Button onAction="#handleGuardarNuevaContrasena" text="Guardar Contraseña" />
            </children>
        </VBox>
        <Label fx:id="mensajeFinalLabel" textFill="GREEN" />
    </children>
</VBox>