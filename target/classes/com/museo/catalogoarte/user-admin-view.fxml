<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.museo.catalogoarte.controller.UserAdminController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Administración de Usuarios">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <TableView fx:id="usuariosTableView" prefHeight="450.0">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="nombreColumn" prefWidth="250.0" text="Nombre" />
                <TableColumn fx:id="emailColumn" prefWidth="300.0" text="Correo Electrónico" />
                <TableColumn fx:id="rolColumn" prefWidth="150.0" text="Rol" />
            </columns>
        </TableView>
        <HBox alignment="CENTER" spacing="10.0">
           <children>
              <Button fx:id="anadirButton" onAction="#handleAnadirUsuario" text="Añadir Usuario" />
              <Button fx:id="editarButton" onAction="#handleEditarUsuario" text="Editar Usuario" />
              <Button fx:id="eliminarButton" onAction="#handleEliminarUsuario" text="Eliminar Usuario" />
           </children>
        </HBox>
    </children>
</VBox>