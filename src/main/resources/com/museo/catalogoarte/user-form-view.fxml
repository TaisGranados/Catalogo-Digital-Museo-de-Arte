<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.museo.catalogoarte.controller.UserFormController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label fx:id="tituloLabel" text="Añadir Nuevo Usuario">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <GridPane hgap="10.0" vgap="10.0">
         <children>
            <Label text="Nombre Completo" />
            <Label text="Correo Electrónico" GridPane.rowIndex="1" />
            <Label text="Contraseña" GridPane.rowIndex="2" />
            <Label text="Rol" GridPane.rowIndex="3" />
            <TextField fx:id="nombreField" GridPane.columnIndex="1" />
            <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <PasswordField fx:id="passwordField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <ComboBox fx:id="rolComboBox" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         </children>
      </GridPane>
      <Button onAction="#handleGuardarUsuario" text="Guardar" />
      <Label fx:id="errorLabel" textFill="RED" />
   </children>
</VBox>