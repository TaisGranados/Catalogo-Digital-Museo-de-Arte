<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="500.0" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.museo.catalogoarte.controller.AdminDashboardController">
   <children>
      <Label text="Panel de Administración">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Button onAction="#handleGestionObras" mnemonicParsing="false" prefHeight="50.0" prefWidth="200.0" text="Gestionar Obras de Arte" />
      <Button onAction="#handleGestionUsuarios" mnemonicParsing="false" prefHeight="50.0" prefWidth="200.0" text="Gestionar Usuarios" />

      <Button onAction="#handleCerrarSesion" mnemonicParsing="false" text="Cerrar Sesión" style="-fx-background-color: #f8d7da;">
         <VBox.margin>
            <Insets top="40.0" />
         </VBox.margin>
      </Button>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>