<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.museo.catalogoarte.controller.LoginController" prefHeight="400" prefWidth="400">
    <padding>
        <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
    </padding>
    <Label text="Bienvenido al Museo">
        <font><Font name="System Bold" size="24.0" /></font>
    </Label>
    <Label fx:id="mensajeLabel" textFill="RED" />
    <TextField fx:id="emailField" promptText="Correo Electrónico" />
    <PasswordField fx:id="passwordField" promptText="Contraseña" />
    <Button onAction="#handleLoginButtonAction" text="Iniciar Sesión" />
    <HBox alignment="CENTER" spacing="10.0">
        <children>
            <Hyperlink onAction="#handleRegistroLink" text="Registrarse" />
            <Label text="|" />
            <Hyperlink onAction="#handleForgotPasswordLink" text="Olvidé mi contraseña" />
        </children>
    </HBox>
</VBox>