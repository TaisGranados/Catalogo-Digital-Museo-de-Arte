<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.museo.catalogoarte.controller.ObraFormController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label fx:id="tituloLabel" text="Añadir Nueva Obra de Arte">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="300.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="80.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Título" />
            <Label text="Artista" GridPane.rowIndex="1" />
            <Label text="Técnica" GridPane.rowIndex="2" />
            <Label text="Año" GridPane.rowIndex="3" />
            <Label text="Descripción" GridPane.rowIndex="4" />
            <Label text="Ruta de Imagen" GridPane.rowIndex="5" />
            <Label text="Ruta de Audio (opcional)" GridPane.rowIndex="6" />
            <Label text="Sala" GridPane.rowIndex="7" />
            <TextField fx:id="tituloField" GridPane.columnIndex="1" />
            <TextField fx:id="artistaField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="tecnicaField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="anioField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <TextArea fx:id="descripcionArea" prefHeight="200.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <TextField fx:id="rutaImagenField" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            <TextField fx:id="rutaAudioField" GridPane.columnIndex="1" GridPane.rowIndex="6" />
            <ComboBox fx:id="salaComboBox" prefWidth="350.0" GridPane.columnIndex="1" GridPane.rowIndex="7" />
         </children>
      </GridPane>
      <Button onAction="#handleGuardar" text="Guardar" />
      <Label fx:id="errorLabel" textFill="RED" />
   </children>
</VBox>